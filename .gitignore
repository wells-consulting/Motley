# macOS
.DS_Store
._*
__MACOSX/

# Editors
*.swp
*.swo

# Xcode, per user
xcuserdata/
DerivedData/
build/
DeveloperOverrides.xcconfig

# Swift Package Manager
.build/
.swiftpm/configuration/registries.json
.swiftpm/configuration/mirrors.json
.swiftpm/xcode/package.xcworkspace/
/Package.resolved

# Python in Scripts and Tools
__pycache__/

# Credentials
.netrc

# Agent tool state; the skill links are committed
!.claude/
.claude/*
!.claude/skills/

# Local scratch space, never shared: database copies, backups, captures,
# diagnostics and large media. Notes, scripts and mockups go in
# Documents/Working, which is tracked.
/Documents/Sandbox/

# Large inputs kept beside tracked notes and scripts
/Documents/**/media/

# Backstop for media, archives and databases anywhere under Documents
/Documents/**/*.mkv
/Documents/**/*.mp4
/Documents/**/*.mov
/Documents/**/*.m4s
/Documents/**/*.zip
/Documents/**/*.db
/Documents/**/*.db-*
/Documents/**/*.sqlite
